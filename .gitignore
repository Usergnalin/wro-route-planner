# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Node (if ever added)
node_modules/
package-lock.json

# The portable single-file build. Reproduce it with `node build.js`.
# Un-ignore this if you would rather the built file be downloadable
# straight from the repo — it is 320 KB and rebuilt by the test suite.
dist/

# Export artifacts (user project files)
*.wro.json
export/

# Competition mat artwork. WRO's asset, not this project's, so it is not
# redistributed here — load your own photo of the mat via Open Image.
WRO-*GameMat*.png

# Saved projects. These embed the mat PHOTO as base64, so they run to
# megabytes each and are personal working files, not source. Ignored so a
# stray `git add -A` can never commit one into the history permanently.
WRO_Project_*.json

# Browser localStorage backups
*.localstorage.json

# Per-machine Claude Code settings (launch.json is shared, this is not)
.claude/settings.local.json
